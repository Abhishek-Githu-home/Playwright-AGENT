{
  "name": "playwright-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:report": "npx playwright test --reporter=list,allure-playwright",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:generate:single-file": "npx allure generate allure-results --clean --single-file -o allure-report-single-file",
    "test:allure": "npm run test:report && npm run allure:generate",
    "allure:open": "npx allure open allure-report",

    "mock:start": "node mock-site/server.js",

    "test:amazon": "npx playwright test --config=playwright.amazon.config.js",
    "test:amazon:bdd": "npx cucumber-js --config cucumber.js",
    "test:amazon:all": "npm run clean:allure && npm run test:amazon; npm run test:amazon:bdd; npm run allure:generate && npm run allure:generate:single-file",

    "clean:allure": "rimraf allure-results allure-report allure-report-single-file test-results && mkdirp allure-results test-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.19.0",
    "allure-cucumberjs": "^3.0.7",
    "allure-playwright": "^2.0.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.0.1"
  }
}